# RUN: llc -mtriple=aarch64 -run-pass=taint-analysis -debug-only=taint-analysis %s -o /dev/null 2>&1 | FileCheck %s
# REQUIRES: aarch64-registered-target
#
# Generated with:
#   clang -O0 -S -emit-llvm <input>.ll
#   opt -passes=taint-annotate -taint-src=...
#   llc -mtriple=aarch64 -O0 -stop-before=taint-analysis

--- |
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64"

  declare i32 @callee(i32)
  declare void @use(i32)

  ; Test 1: tainted arg passed to call — return reg is tainted.
  define i32 @test_tainted_arg(i32 "tainted" %secret) noinline nounwind {
  entry:
    %ret = call i32 @callee(i32 %secret)
    ret i32 %ret
  }

  ; Test 2: clean arg — return reg is CONSERVATIVELY tainted (intra-procedure assumption).
  define i32 @test_clean_arg(i32 %val) noinline nounwind {
  entry:
    %ret = call i32 @callee(i32 %val)
    ret i32 %ret
  }

  ; Test 3: tainted secret stored before call, loaded and used after call.
  define void @test_call_clobber(i32 "tainted" %secret) noinline nounwind {
  entry:
    %copy = add i32 %secret, 0
    call i32 @callee(i32 %secret)
    call void @use(i32 %copy)
    ret void
  }

  attributes #0 = { noinline nounwind }
...
---
name:            test_tainted_arg
alignment:       4
exposesReturnsTwice: false
legalized:       true
regBankSelected: true
selected:        true
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:       []
liveins:
  - { reg: '$w0', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       16
  offsetAdjustment: 0
  maxAlignment:    16
  adjustsStack:    true
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:
  - { id: 0, name: '', type: spill-slot, offset: -16, size: 8, alignment: 16,
      stack-id: default, callee-saved-register: '$lr', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  hasRedZone:      false
  stackSizeZPR:    0
  stackSizePPR:    0
  hasStackFrame:   true
body:             |
  bb.1.entry:
    liveins: $w0, $lr

    early-clobber $sp = frame-setup STRXpre killed $lr, $sp, -16 :: (store (s64) into %stack.0)
    BL @callee, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $w0, implicit-def $w0
    early-clobber $sp, $lr = frame-destroy LDRXpost $sp, 16 :: (load (s64) from %stack.0)
    RET_ReallyLR implicit killed $w0
...

# CHECK-LABEL: TaintAnalysis: analyzing function test_tainted_arg
# CHECK: Marked physical register $w0 as tainted (from arg 0)
# CHECK: taint return reg $w0 (call)
# CHECK: TaintAnalysisPass: test_tainted_arg has 1 tainted register(s)

---
name:            test_clean_arg
alignment:       4
exposesReturnsTwice: false
legalized:       true
regBankSelected: true
selected:        true
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:       []
liveins:
  - { reg: '$w0', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       16
  offsetAdjustment: 0
  maxAlignment:    16
  adjustsStack:    true
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:
  - { id: 0, name: '', type: spill-slot, offset: -16, size: 8, alignment: 16,
      stack-id: default, callee-saved-register: '$lr', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  hasRedZone:      false
  stackSizeZPR:    0
  stackSizePPR:    0
  hasStackFrame:   true
body:             |
  bb.1.entry:
    liveins: $w0, $lr

    early-clobber $sp = frame-setup STRXpre killed $lr, $sp, -16 :: (store (s64) into %stack.0)
    BL @callee, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $w0, implicit-def $w0
    early-clobber $sp, $lr = frame-destroy LDRXpost $sp, 16 :: (load (s64) from %stack.0)
    RET_ReallyLR implicit killed $w0
...

# CHECK-LABEL: TaintAnalysis: analyzing function test_clean_arg
# CHECK: taint return reg $w0 (call)
# CHECK: TaintAnalysisPass: test_clean_arg has 1 tainted register(s)

---
name:            test_call_clobber
alignment:       4
exposesReturnsTwice: false
legalized:       true
regBankSelected: true
selected:        true
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:       []
liveins:
  - { reg: '$w0', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       32
  offsetAdjustment: 0
  maxAlignment:    16
  adjustsStack:    true
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:
  - { id: 0, name: '', type: spill-slot, offset: -20, size: 4, alignment: 4,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: '', type: spill-slot, offset: -16, size: 8, alignment: 16,
      stack-id: default, callee-saved-register: '$lr', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  hasRedZone:      false
  stackSizeZPR:    0
  stackSizePPR:    0
  hasStackFrame:   true
body:             |
  bb.1.entry:
    liveins: $w0, $lr

    $sp = frame-setup SUBXri $sp, 32, 0
    frame-setup STRXui killed $lr, $sp, 2 :: (store (s64) into %stack.1)
    renamable $w8 = ADDWri renamable $w0, 0, 0
    STRWui $w8, $sp, 3 :: (store (s32) into %stack.0)
    BL @callee, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $w0, implicit-def $w0
    $w0 = LDRWui $sp, 3 :: (load (s32) from %stack.0)
    BL @use, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $w0
    $lr = frame-destroy LDRXui $sp, 2 :: (load (s64) from %stack.1)
    $sp = frame-destroy ADDXri $sp, 32, 0
    RET_ReallyLR
...

# CHECK-LABEL: TaintAnalysis: analyzing function test_call_clobber
# CHECK: Marked physical register $w0 as tainted (from arg 0)
# CHECK: set $w8 as tainted
# CHECK: taint unknown mem (store)
# CHECK: taint return reg $w0 (call)
# CHECK: taint defs (load)
# CHECK: set $w0 as tainted
# CHECK: TaintAnalysisPass: test_call_clobber has 3 tainted register(s)
